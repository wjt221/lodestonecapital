# =============================================================================
# LODESTONE CAPITAL - Environment Configuration
# =============================================================================
# Copy this file to .env.local for local development
# Never commit .env.local or any file containing real secrets to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Base URL for the application (used for OAuth callbacks, email links, etc.)
NEXTAUTH_URL=http://localhost:3000

# Secret used to sign and encrypt NextAuth.js session tokens
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# Application environment: development | staging | production
NODE_ENV=development

# Application URL (same as NEXTAUTH_URL in most cases)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application name displayed in emails and UI
NEXT_PUBLIC_APP_NAME="Lodestone Capital"

# -----------------------------------------------------------------------------
# Database (PostgreSQL via Supabase or self-hosted)
# -----------------------------------------------------------------------------
# Primary database connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/lodestonecapital?schema=public

# Direct connection URL (used for migrations, bypasses connection pooler)
# Required when using Supabase with pgBouncer connection pooling
DIRECT_URL=postgresql://postgres:password@localhost:5432/lodestonecapital?schema=public

# -----------------------------------------------------------------------------
# Redis (for BullMQ job queues and session caching)
# -----------------------------------------------------------------------------
# Redis connection URL
# Format: redis://[:password@]host[:port][/db-number]
REDIS_URL=redis://localhost:6379

# Redis host (alternative to REDIS_URL)
REDIS_HOST=localhost

# Redis port
REDIS_PORT=6379

# Redis password (leave empty for local development without auth)
REDIS_PASSWORD=

# Redis database number (0-15)
REDIS_DB=0

# -----------------------------------------------------------------------------
# AWS S3 (Document storage for data rooms)
# -----------------------------------------------------------------------------
# AWS region where your S3 bucket is located
AWS_REGION=us-east-1

# AWS access key ID for programmatic access
AWS_ACCESS_KEY_ID=your-aws-access-key-id

# AWS secret access key
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# S3 bucket name for document storage
AWS_S3_BUCKET_NAME=lodestone-capital-documents

# S3 bucket name for investor reports
AWS_S3_REPORTS_BUCKET=lodestone-capital-reports

# CloudFront distribution URL for serving documents (optional)
AWS_CLOUDFRONT_URL=https://your-distribution-id.cloudfront.net

# -----------------------------------------------------------------------------
# AWS KMS (Key Management Service for document encryption)
# -----------------------------------------------------------------------------
# KMS key ARN used for server-side encryption of sensitive documents
AWS_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/your-key-id

# KMS key ID (short form, used for some operations)
AWS_KMS_KEY_ID=your-kms-key-id

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# Resend API key for transactional emails
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# Default from address for outgoing emails
EMAIL_FROM=noreply@lodestonecapital.com

# Name displayed as the email sender
EMAIL_FROM_NAME="Lodestone Capital"

# Support email address
EMAIL_SUPPORT=support@lodestonecapital.com

# Compliance email address for regulatory notifications
EMAIL_COMPLIANCE=compliance@lodestonecapital.com

# -----------------------------------------------------------------------------
# Authentication Providers (OAuth)
# -----------------------------------------------------------------------------
# Google OAuth (for team member SSO)
# Create at: https://console.developers.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft Azure AD (for enterprise SSO)
# Create at: https://portal.azure.com/
AZURE_AD_CLIENT_ID=your-azure-ad-client-id
AZURE_AD_CLIENT_SECRET=your-azure-ad-client-secret
AZURE_AD_TENANT_ID=your-azure-ad-tenant-id

# -----------------------------------------------------------------------------
# Encryption & Security
# -----------------------------------------------------------------------------
# Application-level encryption key for sensitive data at rest
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-char-hex-encryption-key-here

# Salt for password hashing (bcrypt rounds)
BCRYPT_ROUNDS=12

# JWT secret for internal token signing (e.g., document access tokens)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here

# JWT expiration for document access tokens (e.g., 1h, 24h, 7d)
JWT_DOCUMENT_TOKEN_EXPIRY=1h

# Rate limiting: max requests per window
RATE_LIMIT_MAX=100

# Rate limiting: window in milliseconds
RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking
# Get from: https://sentry.io/
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Sentry organization slug (for source map uploads)
SENTRY_ORG=lodestone-capital

# Sentry project name
SENTRY_PROJECT=lodestonecapital

# Sentry auth token (for CI/CD source map uploads)
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Datadog API key (for APM and infrastructure monitoring)
DD_API_KEY=your-datadog-api-key

# Datadog application key
DD_APP_KEY=your-datadog-app-key

# Log level: error | warn | info | debug
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable AI-powered deal screening features
FEATURE_AI_SCREENING=false

# Enable automated report generation
FEATURE_AUTO_REPORTS=false

# Enable expert network integrations
FEATURE_EXPERT_NETWORK=false

# Enable LP portal features
FEATURE_LP_PORTAL=true

# Enable two-factor authentication requirement
FEATURE_REQUIRE_2FA=false

# Maintenance mode (shows maintenance page to non-admin users)
FEATURE_MAINTENANCE_MODE=false

# -----------------------------------------------------------------------------
# External Integrations (Optional)
# -----------------------------------------------------------------------------
# OpenAI API key (for AI-powered features)
OPENAI_API_KEY=sk-your-openai-api-key

# OpenAI model to use for analysis
OPENAI_MODEL=gpt-4o

# Anthropic API key (alternative AI provider)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# PitchBook API key (market data)
PITCHBOOK_API_KEY=your-pitchbook-api-key

# Crunchbase API key (company data)
CRUNCHBASE_API_KEY=your-crunchbase-api-key

# Bloomberg API key (financial data)
BLOOMBERG_API_KEY=your-bloomberg-api-key

# Carta API key (cap table management)
CARTA_API_KEY=your-carta-api-key

# DocuSign integration key (for LP agreement signing)
DOCUSIGN_INTEGRATION_KEY=your-docusign-integration-key
DOCUSIGN_USER_ID=your-docusign-user-id
DOCUSIGN_ACCOUNT_ID=your-docusign-account-id
DOCUSIGN_PRIVATE_KEY_PATH=/path/to/docusign/private.key
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi

# Slack webhook URL (for internal notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
SLACK_CHANNEL_DEALS=#deal-flow
SLACK_CHANNEL_ALERTS=#platform-alerts

# -----------------------------------------------------------------------------
# Compliance & Regulatory
# -----------------------------------------------------------------------------
# SEC EDGAR API key (for regulatory filings)
SEC_API_KEY=your-sec-api-key

# Compliance document retention period in days (SEC requires 5 years = 1825 days)
COMPLIANCE_RETENTION_DAYS=1825

# Enable audit logging to external SIEM
AUDIT_LOG_EXTERNAL=false

# External audit log endpoint
AUDIT_LOG_ENDPOINT=https://your-siem.example.com/api/events

# Audit log API key
AUDIT_LOG_API_KEY=your-audit-log-api-key

# -----------------------------------------------------------------------------
# Performance & Caching
# -----------------------------------------------------------------------------
# Cache TTL for portfolio data in seconds (5 minutes)
CACHE_TTL_PORTFOLIO=300

# Cache TTL for fund metrics in seconds (15 minutes)
CACHE_TTL_FUND_METRICS=900

# Cache TTL for user sessions in seconds (1 hour)
CACHE_TTL_SESSION=3600

# Maximum file upload size in bytes (100 MB)
MAX_UPLOAD_SIZE=104857600

# Allowed file types for data room uploads (comma-separated MIME types)
ALLOWED_FILE_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/jpeg,image/png

# -----------------------------------------------------------------------------
# Development & Testing
# -----------------------------------------------------------------------------
# Enable database seeding via API endpoint (development only)
ENABLE_SEED_ENDPOINT=false

# Mock external services in development
MOCK_EXTERNAL_SERVICES=false

# Enable detailed query logging
PRISMA_LOG_QUERIES=false

# Test database URL (used by Jest)
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/lodestonecapital_test?schema=public
